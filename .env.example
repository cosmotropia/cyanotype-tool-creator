# Copy this file to `.env` (never commit it) and restart `npm run dev`.

# Public address of the app, used for link previews (og:image, og:url). No trailing slash.
# Leave empty to use the default in vite.config.js.
# Example: SITE_URL=https://cyanotype-tool-creator.vercel.app
SITE_URL=

# AI features (prompt → picture, "Vary current result"). Off = "Coming soon": no request ever reaches OpenAI.
# Set to true once you have a paid OpenAI key.
VITE_AI_ENABLED=false

# The key stays on the dev server; the browser never sees it. Only used when VITE_AI_ENABLED=true.
OPENAI_API_KEY=

# Optional: image model used for generation and refinement (default: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1
